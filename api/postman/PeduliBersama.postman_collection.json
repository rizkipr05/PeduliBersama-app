  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Register success', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 409]);",
                  "});",
                  "if (json?.data?.id) {",
                  "  pm.collectionVariables.set('userId', String(json.data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('User login success', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(json?.data?.accessToken).to.be.a('string').and.not.empty;",
                  "});",
                  "if (json?.data?.accessToken) {",
                  "  pm.collectionVariables.set('userToken', json.data.accessToken);",
                  "}",
                  "if (json?.data?.id) {",
                  "  pm.collectionVariables.set('userId', String(json.data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
