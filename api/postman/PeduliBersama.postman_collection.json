              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disasterId\": {{disasterId}},\n  \"nominal\": {{donationNominal}},\n  \"paymentMethod\": \"{{donationPaymentMethod}}\",\n  \"donorName\": \"{{donationDonorName}}\",\n  \"donorEmail\": \"{{donationDonorEmail}}\"\n}"
            },
